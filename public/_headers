# Cloudflare Pages cache rules. Without these every asset is served
# `max-age=0, must-revalidate` and repeat visitors re-download the lot.

# Content-hashed by Next — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed: a filename is reused when artwork is swapped, so cap at 30 days
# rather than immutable. Bump the filename if a change must land sooner.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
